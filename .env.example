
# Supabase Configuration (PRODUCTION)
# Get these values from your Supabase project settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server Configuration
PORT=3001
NODE_ENV=production

# Frontend Configuration
# For production: https://walknplay.ru,https://stage.walknplay.ru
# For local development: http://localhost:3000
# Multiple origins separated by comma (no spaces after commas!)
ALLOWED_ORIGINS=https://walknplay.ru,https://stage.walknplay.ru,http://localhost:3000

# Cookie domain for cross-subdomain auth (production only)
# Set to parent domain so cookie from api.walknplay.ru is readable by walknplay.ru
# Leave empty for local development (cookie scoped to localhost)
COOKIE_DOMAIN=.walknplay.ru

# Email redirect URLs (update with your production domain)
EMAIL_REDIRECT_URL=https://stage.walknplay.ru/confirm
FRONTEND_URL=https://stage.walknplay.ru
PASSWORD_RESET_REDIRECT_URL=https://stage.walknplay.ru/new-password

# S3 / MinIO Configuration (Coolify)
# Primary variables for your setup
# Bucket now comes from API request body (`bucket`) for presign methods.
# IMPORTANT: MINIO_BROWSER_REDIRECT_URL is for MinIO Console UI, not for direct object URLs.
MINIO_SERVER_URL=https://s3-api.walknplay.ru
MINIO_BROWSER_REDIRECT_URL=https://s3.walknplay.ru
MINIO_ROOT_USER=your-minio-user
MINIO_ROOT_PASSWORD=your-minio-password

# Optional S3 overrides
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SECONDS=900
# Optional: explicit public base URL for ready-to-use file links
# S3_PUBLIC_BASE_URL=https://cdn.your-domain.com
